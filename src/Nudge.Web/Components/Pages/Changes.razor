@page "/changes"
@inject UiQueries Queries
@inject WebWrites Writes

<PageTitle>Changes - Nudge</PageTitle>

<h1>Changes</h1>
<p class="hint">
    The latest @UiQueries.RecentChanges changes, newest first. Undoing
    one is itself a change, which can be undone in turn.
</p>

@* The roles are what a table has anyway; they are spelled out
   because the phone layout's display rules take a table's own
   semantics away in some browsers. *@
<table class="changes" role="table">
    <thead role="rowgroup">
        <tr role="row">
            <th role="columnheader">#</th>
            <th role="columnheader">When</th>
            <th role="columnheader">What</th>
            <th role="columnheader">By</th>
            <th role="columnheader"></th>
        </tr>
    </thead>
    <tbody role="rowgroup">
        @foreach (var change in _changes)
        {
            <tr role="row">
                <td role="cell">@change.Id</td>
                <td role="cell">@Words.Instant(change.At, Queries.Zone)</td>
                <td role="cell">
                    @change.Description
                    @if (change.Undoes is { } undone)
                    {
                        <span class="fact">undoes @undone</span>
                    }
                </td>
                <td role="cell">@change.Source</td>
                <td role="cell">
                    <ActionForm Name="@($"undo-{change.Id}")"
                                Action="Undo(change.Id)"
                                Class="inline">
                        <button type="submit">Undo</button>
                    </ActionForm>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private IReadOnlyList<Nudge.Web.Data.Change> _changes = [];

    private Func<IFormCollection, string, Task<WebWriteResult>> Undo(
        long changeId)
    {
        return (form, key) => Writes.UndoAsync(key, changeId);
    }

    protected override async Task OnInitializedAsync()
    {
        _changes = await Queries.ChangesAsync();
    }
}
