<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Nudge.Core\Nudge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core brings Microsoft.Data.Sqlite with it, so the two
         cannot end up on different versions. EF Core 11 needs
         .NET 11: stay on 10.0.x while this project targets
         net10.0, and keep dotnet-tools.json on the same version. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
